{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".claude/**",
    ".impl-context/**",
    ".impl/**",
    ".address-context/**",
    ".address/**",
    ".review-context/**",
    ".review/**",
    ".triage-context/**",
    ".triage/**",
    ".autofix-context/**",
    ".autofix/**"
  ],
  "overrides": [
    {
      "files": ["**/*.md", "**/*.mdx"],
      "excludeFiles": ["website/**"],
      "options": {
        "proseWrap": "never"
      }
    }
  ]
}
