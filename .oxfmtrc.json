{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".claude/**",
    ".impl-context/**",
    ".address-context/**",
    ".address/**",
    ".review-context/**"
  ],
  "overrides": [
    {
      "files": ["**/*.md", "**/*.mdx"],
      "excludeFiles": ["website/**"],
      "options": {
        "proseWrap": "never"
      }
    }
  ]
}
