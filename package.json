{
  "name": "@smonn/ids",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Simon Ingeson (https://github.com/smonn)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smonn/ids.git"
  },
  "bin": {
    "ids": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "bench:build": "tsdown -c tsdown.bench.config.ts",
    "bench": "pnpm -s bench:build 1>&2 && node bench/dist/index.mjs",
    "bench:compare": "pnpm -s bench:build 1>&2 && node bench/dist/compare.mjs",
    "version-packages": "changeset version && pnpm fmt"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.7",
    "knip": "6.15.0",
    "mitata": "1.0.34",
    "oxfmt": "0.52.0",
    "oxlint": "1.67.0",
    "tsdown": "0.22.1",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.4.0"
}
