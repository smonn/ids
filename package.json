    "@vitest/coverage-v8": "4.1.7",
    "knip": "6.14.2",
    "oxfmt": "0.52.0",
    "oxlint": "1.67.0",
    "tsdown": "0.22.1",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.4.0"
}
