{
  "name": "@smonn/ids",
  "version": "0.11.0",
  "license": "MIT",
  "author": "Simon Ingeson (https://github.com/smonn)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smonn/ids.git"
  },
  "bin": {
    "ids": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./opaque": "./dist/opaque.mjs",
    "./reverse": "./dist/reverse.mjs",
    "./signed": "./dist/signed.mjs",
    "./wrapped": "./dist/wrapped.mjs",
    "./digest": "./dist/digest.mjs",
    "./drizzle": "./dist/drizzle.mjs",
    "./hono": "./dist/hono.mjs",
    "./kysely": "./dist/kysely.mjs",
    "./prisma": "./dist/prisma.mjs",
    "./express": "./dist/express.mjs",
    "./fastify": "./dist/fastify.mjs",
    "./typeorm": "./dist/typeorm.mjs",
    "./graphql": "./dist/graphql.mjs",
    "./nestjs": "./dist/nestjs.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "depcruise": "depcruise --config .dependency-cruiser.cjs \"src/**/*.ts\" \"bin/**/*.ts\"",
    "knip": "knip",
    "bench:build": "tsdown -c tsdown.bench.config.ts",
    "bench": "pnpm -s bench:build 1>&2 && node bench/dist/index.mjs",
    "bench:compare": "pnpm -s bench:build 1>&2 && node bench/dist/compare.mjs",
    "version-packages": "changeset version && pnpm fmt"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@nestjs/common": "^11.1.27",
    "@prisma/client": ">=5.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "4.1.8",
    "dependency-cruiser": "17.4.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "fastify": "^5.8.5",
    "graphql": "^17.0.1",
    "hono": "^4.12.26",
    "knip": "6.18.0",
    "kysely": "^0.29.2",
    "mitata": "1.0.34",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "reflect-metadata": "^0.2.2",
    "tsdown": "0.22.3",
    "tslib": "^2.8.1",
    "typeorm": "^1.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@prisma/client": ">=5.0.0",
    "drizzle-orm": ">=0.30.0",
    "express": ">=4.0.0",
    "fastify": ">=4.0.0",
    "graphql": ">=16.0.0",
    "hono": ">=4.0.0",
    "kysely": ">=0.27.0",
    "typeorm": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "graphql": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "kysely": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.4.0"
}
