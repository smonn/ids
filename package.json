{
  "name": "@smonn/ids",
  "version": "1.0.0-rc.5",
  "license": "MIT",
  "author": "Simon Ingeson (https://github.com/smonn)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smonn/ids.git"
  },
  "bin": {
    "ids": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "spec/vectors.json"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./opaque": {
      "types": "./dist/opaque.d.mts",
      "default": "./dist/opaque.mjs"
    },
    "./reverse": {
      "types": "./dist/reverse.d.mts",
      "default": "./dist/reverse.mjs"
    },
    "./signed": {
      "types": "./dist/signed.d.mts",
      "default": "./dist/signed.mjs"
    },
    "./wrapped": {
      "types": "./dist/wrapped.d.mts",
      "default": "./dist/wrapped.mjs"
    },
    "./digest": {
      "types": "./dist/digest.d.mts",
      "default": "./dist/digest.mjs"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.mts",
      "default": "./dist/drizzle.mjs"
    },
    "./hono": {
      "types": "./dist/hono.d.mts",
      "default": "./dist/hono.mjs"
    },
    "./kysely": {
      "types": "./dist/kysely.d.mts",
      "default": "./dist/kysely.mjs"
    },
    "./mikro-orm": {
      "types": "./dist/mikro-orm.d.mts",
      "default": "./dist/mikro-orm.mjs"
    },
    "./prisma": {
      "types": "./dist/prisma.d.mts",
      "default": "./dist/prisma.mjs"
    },
    "./express": {
      "types": "./dist/express.d.mts",
      "default": "./dist/express.mjs"
    },
    "./fastify": {
      "types": "./dist/fastify.d.mts",
      "default": "./dist/fastify.mjs"
    },
    "./typeorm": {
      "types": "./dist/typeorm.d.mts",
      "default": "./dist/typeorm.mjs"
    },
    "./graphql": {
      "types": "./dist/graphql.d.mts",
      "default": "./dist/graphql.mjs"
    },
    "./nestjs": {
      "types": "./dist/nestjs.d.mts",
      "default": "./dist/nestjs.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "sbom:generate": "cdxgen --type pnpm --spec-version 1.6 --output sbom.cdx.json .",
    "pack:check": "attw --pack . --profile esm-only && publint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "depcruise": "depcruise --config .dependency-cruiser.cjs \"src/**/*.ts\" \"bin/**/*.ts\"",
    "knip": "knip",
    "bench:build": "tsdown -c tsdown.bench.config.ts",
    "bench": "pnpm -s bench:build 1>&2 && node bench/dist/index.mjs",
    "bench:compare": "pnpm -s bench:build 1>&2 && node bench/dist/compare.mjs",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.4",
    "@changesets/cli": "2.31.0",
    "@cyclonedx/cdxgen": "12.7.0",
    "@mikro-orm/core": "^7.1.5",
    "@nestjs/common": "^11.1.27",
    "@nestjs/testing": "^11.1.27",
    "@prisma/client": ">=7.8.0",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "26.0.1",
    "@vitest/coverage-v8": "4.1.9",
    "better-sqlite3": "^12.11.1",
    "dependency-cruiser": "18.0.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "fast-check": "^4.8.0",
    "fastify": "^5.8.5",
    "graphql": "^17.0.1",
    "hono": "^4.12.27",
    "knip": "6.22.0",
    "kysely": "^0.29.2",
    "mitata": "1.0.34",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "publint": "0.3.21",
    "reflect-metadata": "^0.2.2",
    "tsdown": "0.22.3",
    "tslib": "^2.8.1",
    "typeorm": "^1.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@mikro-orm/core": ">=7.0.0",
    "@nestjs/common": ">=11.0.0",
    "@prisma/client": ">=7.0.0",
    "drizzle-orm": ">=0.36.0",
    "express": ">=4.0.0",
    "fastify": ">=4.0.0",
    "graphql": ">=16.0.0 <18.0.0",
    "hono": ">=4.6.15",
    "kysely": ">=0.27.0",
    "typeorm": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@mikro-orm/core": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "graphql": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "kysely": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.4.0"
}
